generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MANAGER
  AUTHOR
}

model User {
  id    Int    @id @default(autoincrement())
  phone String @unique
  roles Role[]

  name   String?
  bio    String?
  avatar String?

  courses       Course[]
  Like          Like[]
  CourseOrder   CourseOrder[]
  CourseComment CourseComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactUs {
  id        Int       @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  topic     TopicEnum
  message   String
  consent   Boolean
  createdAt DateTime  @default(now())
}

enum TopicEnum {
  عمومی
  عضویت
  رویدادها
  پشتیبانی_فنی
}

model RequestCollaborate {
  id              Int              @id @default(autoincrement())
  name            String
  email           String
  phone           String?
  roles           String[]
  experienceYears String?
  hoursPerWeek    String?
  expertise       String
  portfolioUrl    String
  linkedin        String?
  githubOrYoutube String?
  location        String?
  message         String?
  acceptTerms     Boolean          @default(false)
  permission      PermissionStatus @default(pending)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum PermissionStatus {
  pending
  approved
  rejected
}

//course model /////////////////////////////////////////////////////////////

model Course {
  id            Int      @id @default(autoincrement())
  image         String
  title         String
  category      String
  description   String
  duration      Int      @default(0)
  price         Int
  originalPrice Int
  requirements  String[]
  whatYouLearn  String[]

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  lessons Lesson[]
  likes   Like[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  CourseOrder   CourseOrder[]
  CourseComment CourseComment[]
}

model Lesson {
  id       Int     @id @default(autoincrement())
  title    String
  duration Int
  order    Int
  isFree   Boolean @default(false)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  episodes Episode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Episode {
  id          Int     @id @default(autoincrement())
  title       String
  duration    Int     @default(0)
  description String?
  videoUrl    String

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Like {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id])
  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model CourseOrder {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  authority String @unique

  status String @default("isPending")
}

model CourseComment {
  id   Int    @id @default(autoincrement())
  text String

  userId Int
  user   User @relation(fields: [userId], references: [id])

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now())
}
