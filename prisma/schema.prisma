generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  phone String @unique
  role  String
}

model ContactUs {
  id       Int      @id @default(autoincrement())
  name     String
  email    String
  phone    String?
  topic    TopicEnum
  message  String
  consent  Boolean
  createdAt DateTime @default(now())
}

enum TopicEnum {
  عمومی
  عضویت
  رویدادها
  پشتیبانی_فنی
}

