generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id     Int            @id @default(autoincrement())
  status UserStatusEnum @default(ACCESS)
  phone  String         @unique
  roles  UserRoleEnum[]

  name   String?
  bio    String?
  avatar String?

  courses       Course[]
  Like          Like[]
  CourseOrder   CourseOrder[]
  CourseComment CourseComment[]

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  AuthorRequestFuns   AuthorRequestFuns[]
  ContactUs           ContactUs[]
  ManagerCourseReport CourseReport[]
  Promotion           Promotion[]
}

enum UserStatusEnum {
  ACCESS
  BLOCK
}

enum UserRoleEnum {
  USER
  MANAGER
  AUTHOR
  ADMIN
}

model ContactUs {
  id        Int       @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  topic     TopicEnum
  message   String
  consent   Boolean
  createdAt DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TopicEnum {
  عمومی
  عضویت
  رویدادها
  پشتیبانی_فنی
}

model RequestCollaborate {
  id              Int                  @id @default(autoincrement())
  name            String
  email           String
  phone           String
  experienceYears String
  hoursPerWeek    String
  expertise       String
  portfolioUrl    String?
  linkedin        String?
  githubOrYoutube String?
  location        String?
  message         String
  acceptTerms     Boolean              @default(false)
  role            RoleEnum
  permission      PermissionStatusEnum @default(pending)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

enum RoleEnum {
  ADMIN
  AUTHOR
}

enum PermissionStatusEnum {
  pending
  approved
  rejected
}

model Course {
  id            Int              @id @default(autoincrement())
  status        CourseStatusEnum @default(creating)
  image         String
  title         String
  category      String
  description   String
  duration      Int              @default(0)
  price         Int
  originalPrice Int
  requirements  String[]
  whatYouLearn  String[]

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  lessons Lesson[]
  likes   Like[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  CourseOrder         CourseOrder[]
  CourseComment       CourseComment[]
  ManagerCourseReport CourseReport[]
  Promotion           Promotion[]
}

enum CourseStatusEnum {
  creating
  waiting
  publish
  rejected
}

model Lesson {
  id       Int              @id @default(autoincrement())
  status   LessonStatusEnum @default(waiting)
  title    String
  duration Int              @default(0)
  order    Int
  isFree   Boolean          @default(false)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  episodes Episode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LessonStatusEnum {
  waiting
  publish
  rejected
}

model Episode {
  id          Int     @id @default(autoincrement())
  title       String
  duration    Int     @default(0)
  order       Int
  description String?
  videoUrl    String

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Like {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id])
  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model CourseOrder {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  price     Int
  authority String @unique

  status CourseOrderStatusEnum @default(isPending)

  promotionCode String?

  createdAt DateTime @default(now())

  @@index([userId, courseId])
}

enum CourseOrderStatusEnum {
  isPending
  success
  failed
}

model CourseComment {
  id     Int                     @id @default(autoincrement())
  status CourseCommentStatusEnum @default(pending)
  text   String

  userId Int
  user   User @relation(fields: [userId], references: [id])

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  reply String? @default("")

  createdAt DateTime @default(now())
}

enum CourseCommentStatusEnum {
  pending
  rejected
  confirm
}

model AuthorRequestFuns {
  id Int @id @default(autoincrement())

  status AuthorRequestFunsStatusEnum @default(PENDING)

  amount     BigInt
  cardNumber String

  transactionId BigInt?

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
}

enum AuthorRequestFunsStatusEnum {
  PENDING
  REJECTED
  SUCCESS
}

model CourseReport {
  id Int @id @default(autoincrement())

  status CourseReportStatusEnum @default(SEND)

  message String

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum CourseReportStatusEnum {
  SEND
  CORRECTION
  ACCEPTE
}

model Promotion {
  id         Int      @id @default(autoincrement())
  code       String
  percent    Int
  expireAt   DateTime
  usageLimit Int      @default(1)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
